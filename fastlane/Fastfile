# World Mapper release lanes. Called by .github/workflows/release.yml.
APP_ID = "com.worldmapper.app"
default_platform(:android)

platform :android do
  desc "Upload the built .aab to Play internal testing"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      release_status: "draft",            # nothing reaches testers until you promote it in the console
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true
    )
  end

  desc "Promote what is in internal testing to production (run by hand)"
  lane :promote do
    upload_to_play_store(
      track: "internal", track_promote_to: "production", release_status: "draft",
      skip_upload_aab: true, skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true
    )
  end
end

platform :ios do
  desc "Build the app and send it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true,
      in_house: false
    )

    # A keychain that exists only for this build.
    create_keychain(name: "build", password: "build", default_keychain: true, unlock: true,
                    timeout: 3600, lock_when_sleeps: false)

    # match keeps the signing certificate and profile encrypted in a private repo, so every
    # build signs with the same identity and there is nothing to renew by hand.
    match(
      type: "appstore",
      app_identifier: APP_ID,
      api_key: api_key,
      readonly: false,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: Base64.strict_encode64(ENV.fetch("MATCH_GIT_TOKEN")),
      keychain_name: "build", keychain_password: "build"
    )
    profile = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_ID]

    update_code_signing_settings(
      path: "ios/App/App.xcodeproj", use_automatic_signing: false,
      team_id: ENV.fetch("IOS_TEAM_ID"), profile_name: profile, code_sign_identity: "Apple Distribution"
    )
    # Version and build number go straight to Xcode's settings (Info.plist reads them from there).
    version_args = []
    version_args << "MARKETING_VERSION=#{ENV['VERSION_NAME']}" if ENV["VERSION_NAME"]
    version_args << "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']}" if ENV["BUILD_NUMBER"]

    cocoapods(podfile: "ios/App/Podfile", repo_update: true)
    build_app(
      workspace: "ios/App/App.xcworkspace", scheme: "App",
      export_method: "app-store", output_directory: "build",
      xcargs: version_args.join(" "),
      export_options: { provisioningProfiles: { APP_ID => profile } }
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
